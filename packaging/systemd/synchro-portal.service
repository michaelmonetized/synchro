# User unit for synchro --portal.
# Dogfood: copy to ~/.config/systemd/user/synchro-portal.service and point
# ExecStart at ./build/synchro. Then:
#   systemctl --user daemon-reload
#   systemctl --user enable --now synchro-portal.service
[Unit]
Description=Synchro FileChooser portal
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=dbus
BusName=org.freedesktop.impl.portal.desktop.synchro
ExecStart=/home/ryanr/repos2026/synchro/build/synchro --portal
Restart=on-failure
RestartSec=1
Environment=XDG_RUNTIME_DIR=%t

[Install]
WantedBy=graphical-session.target
