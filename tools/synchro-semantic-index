#!/usr/bin/env python3
"""Build and query Synchro's local CLIP image index.

The canonical file catalog remains small and operational. Dense vectors live in
semantic.sqlite and are keyed by the stable filesystem identity plus source
size/mtime, so moved files are reused and changed files are recomputed. Text
queries use the matching CLIP encoder and exact, folder-scoped cosine ranking.
"""

from __future__ import annotations

