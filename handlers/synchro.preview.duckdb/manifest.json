{
  "schemaVersion": 1,
  "id": "synchro.preview.duckdb",
  "name": "DuckDB preview",
  "version": "1.0.0",
  "author": "Omarchy",
  "license": "MIT",
  "description": "Browse tables and a row sample from a DuckDB file. Needs duckdb on PATH.",
  "kinds": ["preview"],
  "priority": 80,
  "match": {
    "matchMode": "any",
    "mime": [
      "application/x-duckdb",
      "application/vnd.duckdb"
    ],
    "suffix": [".duckdb", ".ddb"],
    "minItems": 1,
    "maxItems": 1,
    "host": "posix-local"
  },
  "entryPoints": {
    "preview": "duckdb.qml"
  },
  "preview": {
    "runtime": "inprocess",
    "inline": "quick-app"
  },
  "permissions": ["fs-read"]
}
